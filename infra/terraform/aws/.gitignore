# Terraform state holds secrets (RDS password, etc.) and per-environment
# runtime data — never commit it. Use a remote backend (S3 + DynamoDB) for
# real deployments; these local files come from validation/ephemeral applies.
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Local variable files may carry secrets; keep them out of the tree.
*.tfvars
*.auto.tfvars
