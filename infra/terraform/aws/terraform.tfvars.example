aws_region  = "us-east-1"
environment = "playground"
project     = "facility"

app_hostname = "app.example.com"
api_hostname = "api.example.com"

# Optional. Leave empty to create only HTTP listeners and print the ALB DNS name.
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/placeholder"
route53_zone_id     = "ZPLACEHOLDER"

# Validation shortcut when no public DNS zone is available. CloudFront provides
# an AWS-managed HTTPS API URL and GitHub webhook URL; leave false when using
# your own hostname and ACM certificate.
enable_cloudfront_api_endpoint = false

# WorkOS is required for production interactive login and protected previews.
# A webhook-only validation deployment can leave it disabled.
enable_workos = true

# Local/bootstrap provider fallback only. Production gateways should load
# provider credentials through the Facility API instead.
enable_dev_provider_fallback = false

# Restrict this for non-public test deployments.
allowed_http_cidr_blocks = ["0.0.0.0/0"]

database_instance_class       = "db.t4g.micro"
database_allocated_storage_gb = 20
database_backup_retention_days = 7

enable_deletion_protection = true
force_destroy_bucket       = false

# Interactive-client MCP OAuth 2.1: set (together with the WORKOS_AUTHKIT_DOMAIN
# secret) to enable WorkOS access-token auth on the MCP resource server; empty
# leaves remote MCP on fak_ API keys only. envelope_retention_days bounds how
# long stored LLM request/response envelopes are kept.
mcp_oauth_audience      = ""
envelope_retention_days = 90

container_image_tags = {
  api     = "replace-with-git-sha"
  worker  = "replace-with-git-sha"
  gateway = "replace-with-git-sha"
  web     = "replace-with-git-sha"
  runner  = "replace-with-git-sha"
}

# Use only when images live outside the ECR repositories created by this module.
image_overrides = {}

# Must match CPU_ARCHITECTURE used by infra/build-images.sh.
task_cpu_architecture = "X86_64"

# Keep 300 for production unless your request-duration SLO allows a shorter
# drain. Ephemeral validation stacks can use 15 to speed repeated deployments.
target_deregistration_delay_seconds = 300
