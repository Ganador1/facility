# Facility platform — development environment
# Copy to .env and adjust. NEVER commit .env.

# --- Core ---
DATABASE_URL=postgres://facility:facility@localhost:5461/facility
# 32 bytes, base64. Generate: openssl rand -base64 32
SECRET_MASTER_KEY=
PORT=4400
PUBLIC_URL=http://localhost:4400
WEB_URL=http://localhost:3400
LOG_LEVEL=info

# Dev-only escape hatch: enables POST /auth/dev-login. Refused in production.
FACILITY_INSECURE_DEV=1

# --- Sandboxes ---
# Image the seeded default sandbox profile uses to run platform-lane agents
# (Claude Code, Codex). Its entrypoint must be the Facility runner — build it
# with `docker build -t facility-runner:dev runner/`. In the cloud, set this to
# your pushed runner image tag. `facility doctor` fails if no profile can run it.
FACILITY_RUNNER_IMAGE=facility-runner:dev

# --- Object storage (MinIO in dev; any S3-compatible in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=facility
S3_SECRET_KEY=facility-dev-secret
S3_BUCKET=facility
AWS_REGION=us-east-1

# --- WorkOS SSO (optional in dev; required in production) ---
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# 32+ chars random
WORKOS_COOKIE_PASSWORD=
WORKOS_AUTHKIT_DOMAIN=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:4400/auth/callback

# --- MCP OAuth 2.1 resource server (optional) ---
# Set MCP_OAUTH_AUDIENCE to enable WorkOS access-token (JWT) auth for interactive
# MCP clients. REQUIRED to enable OAuth: the control plane keeps JWT auth disabled
# (fak_ keys only) unless this is set, so `aud` is always validated.
MCP_OAUTH_AUDIENCE=
# For `facility-mcp serve` OAuth discovery (RFC 9728). MCP_PUBLIC_URL is this MCP
# server's public URL; MCP_AUTHORIZATION_SERVER defaults to WORKOS_AUTHKIT_DOMAIN.
MCP_PUBLIC_URL=
MCP_AUTHORIZATION_SERVER=

# --- LLM gateway (provider credentials are normally stored sealed via the API;
#     these env fallbacks exist for local development only) ---
GATEWAY_PORT=4410
DEV_ANTHROPIC_API_KEY=
DEV_OPENAI_API_KEY=

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
